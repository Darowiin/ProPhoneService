POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=prophoneservice
JWT_KEY=change-me-32-chars-minimum-secret
MASTER_EMAIL=master@example.com

# Почта (Resend): на демо - onboarding@resend.dev (письма только на адрес владельца ключа),
# после покупки домена - EMAIL_FROM=noreply@<домен>
RESEND_API_KEY=set-your-resend-api-key
EMAIL_FROM=onboarding@resend.dev

